# Gloss keeps no API keys on the server. Readers paste their own Fortytwo key
# (required), Exa key (web search, optional) and LlamaParse key ("Read it more
# carefully" on hard PDFs, optional) in the app; they stay in the browser.

# The public origin, for canonical and social card URLs.
NEXT_PUBLIC_SITE_URL=https://usegloss.io
